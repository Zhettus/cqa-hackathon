# Источник данных организаторов: GET {DATA_API_URL}?group_id=DEV
DATA_API_URL=
DATA_API_TIMEOUT_S=30
# SQLite
DB_PATH=data/cqa.db
# Локальные наборы data/{group_id}.json
DATA_DIR=data

# --- LLM ---
# anthropic | openai (любой OpenAI-совместимый: Ollama, vLLM, LM Studio)
LLM_PROVIDER=anthropic
# по умолчанию для anthropic: claude-opus-5-5; для Ollama, например: qwen2.5:32b
LLM_MODEL=
# для openai-совместимых обязателен, напр. http://localhost:11434/v1 (Ollama) или http://localhost:8000/v1 (vLLM)
LLM_BASE_URL=
# ключ; для anthropic можно не задавать, если есть ANTHROPIC_API_KEY или профиль `ant auth login`
LLM_API_KEY=
# anthropic: глубина рассуждения low|medium|high|xhigh|max
LLM_EFFORT=high
# anthropic: серверный fallback на другую модель при отказе (1/0)
LLM_FALLBACKS=1
LLM_MAX_TOKENS=16000
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
# одновременных вызовов модели (семафор на процесс)
LLM_CONCURRENCY=8
# цены USD за 1M токенов (для известных моделей Claude есть значения по умолчанию)
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_PRICE_CACHE_READ_PER_MTOK=
LLM_PRICE_CACHE_WRITE_PER_MTOK=
# голосов на критерий: 1 для разработки, 3 для финального прогона
VOTES=1
# нормализация текста звонков моделью-корректором перед оценкой (этап 5): 1/0.
# Результат кэшируется по диалогу и версии корректора; оригинальный текст не меняется.
NORMALIZE_CALLS=0
